# Storage API URL for cloud mode (optional override)
# If not set:
#   - Development: Uses Vite proxy (/api/storage → localhost:7243)
#   - Production/Lovable: Uses Cloudflare Tunnel (https://api.chaycards.com/api/storage)
#
# Uncomment to override the default:
# VITE_STORAGE_API_URL=https://api.chaycards.com/api/storage

# ============================================
# Notion PM Sync Server Configuration
# ============================================

# API Key for authenticating sync requests from Notion button
# Generate a secure random string for production use
NOTION_PM_API_KEY=dev-secret-key-change-in-production

# Port for the sync server (default: 3001)
NOTION_PM_PORT=3001

# Notion API Integration Token
# Get from: https://www.notion.so/my-integrations
# Or use existing NOTION_API_KEY from environment
NOTION_API_KEY=ntn_your_notion_api_key_here
