# ========================================
# ChayCards Environment Configuration
# ========================================
# This file documents all available environment variables.
#
# For development: Copy to .env.development
# For production: Copy to .env.production
#
# Vite automatically loads the correct file based on command:
# - npm run dev   → .env.development
# - npm run build → .env.production

# ========================================
# FRONTEND (Required)
# ========================================

# API Base URL - Automatically set by environment
# Development: https://dev-api.chaycards.com
# Production: https://api.chaycards.com
VITE_API_URL=https://dev-api.chaycards.com

# Environment name (for debugging)
VITE_ENV=development

# ========================================
# BACKEND SERVERS (Docker Internal)
# ========================================

# Database Connection (used by API server)
DATABASE_URL=postgresql://postgres:dev@postgres:5432/chaycards_dev

# API Server Configuration
PORT=3101
JWT_SECRET=dev-secret-change-in-production
NODE_ENV=development

# PostgreSQL Root Password (Docker)
POSTGRES_PASSWORD=dev

# ========================================
# DEVELOPMENT TOOLS (Optional)
# ========================================

# Notion PM Integration (for task tracking)
NOTION_API_KEY=secret_xxxxxxxxxxxxx
NOTION_PM_PORT=3001
NOTION_PM_API_KEY=dev-secret-key-change-in-production

# ========================================
# DOMAIN STRUCTURE
# ========================================
# Development:
#   - Frontend: https://dev.chaycards.com
#   - API: https://dev-api.chaycards.com
#   - Tools: https://dev-tools.chaycards.com
#
# Production:
#   - Frontend: https://chaycards.com
#   - API: https://api.chaycards.com
