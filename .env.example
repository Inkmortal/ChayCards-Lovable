# Storage API URL for cloud mode (optional override)
# If not set:
#   - Development: Uses Vite proxy (/api/storage → localhost:7243)
#   - Production/Lovable: Uses Cloudflare Tunnel (https://api.chaycards.com/api/storage)
#
# Uncomment to override the default:
# VITE_STORAGE_API_URL=https://api.chaycards.com/api/storage
