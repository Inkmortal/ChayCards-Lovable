# ========================================
# ChayCards Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# PRODUCT SERVERS
# ========================================

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:dev@localhost:5433/chaycards

# Express API Server
PORT=3101
JWT_SECRET=dev-secret-change-in-production
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Storage API URL (optional override for production)
# VITE_STORAGE_API_URL=https://api.chaycards.com/api/storage

# ========================================
# DEVELOPMENT SERVERS (Vibe Coding)
# ========================================

# Notion PM Sync (Required for task tracking)
NOTION_API_KEY=secret_xxxxxxxxxxxxx
NOTION_PM_PORT=3001
NOTION_PM_API_KEY=dev-secret-key-change-in-production

# Embedding Server (Auto-detects GPU/CPU)
# No configuration needed - runs automatically

# LLM Compressor (External Mac Mini)
# Hardcoded to http://192.168.1.58:1243
# No configuration needed

# ========================================
# NOTES
# ========================================
# - All servers run in Docker containers
# - Product servers: Required for cloud storage mode
# - Dev servers: Required for vibe coding (RAG system)
# - Local SQLite: No configuration needed (embedded in Electron)
